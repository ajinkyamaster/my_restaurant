<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Booking Confirmed</title>
    <link rel="stylesheet" href="/styles/bookingConfirmed.css">
</head>

<body>

    <header class="navbar">
        <h1 class="logo">My Restaurant</h1>
        <nav>
            <a href="/">Home</a>
            <a href="/menu">Menu</a>
            <a href="/bookTable">Book a Table</a>
            <a href="/cart">Cart</a>
            <a href="/orders">Orders</a>
            <a href="/payments">My Payments</a>
            <a href="#">About Us</a>
        </nav>
    </header>

    <section class="confirmation-section">
        <h2>🎉 Booking Confirmed!</h2>

        <div class="details">
            <p><strong>Name:</strong>
                <%= booking.customerName %>
            </p>
            <p><strong>Contact:</strong>
                <%= booking.contact %>
            </p>
            <p><strong>Table Number:</strong>
                <%= booking.tableNumber %>
            </p>
            <p><strong>Date & Time:</strong>
                <%= booking.dateTimeIn %>
            </p>
        </div>

        <p class="note">Please arrive on time. We look forward to serving you!</p>
    </section>

</body>

</html>
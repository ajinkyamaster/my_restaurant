<!DOCTYPE html>
<html>

<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Your Orders</title>
    <link
        href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Inter:wght@300;400;500;600&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="/styles/base.css">
    <link rel="stylesheet" href="/styles/layout.css">
    <link rel="stylesheet" href="/styles/components.css">
    <link rel="stylesheet" href="/styles/pages/orders.css">

    <link rel="stylesheet" href="/styles/mobile-nav.css">
    <script src="/scripts/mobile-nav.js" defer></script>
</head>

<body>

    <header class="navbar">
        <h1 class="logo">My Restaurant</h1>

         <div class="hamburger">
            <span></span>
            <span></span>
            <span></span>
        </div>

        <nav>
            <a href="/">Home</a>
            <a href="/menu">Menu</a>
            <a href="/bookTable">Book a Table</a>
            <a href="/cart">Cart</a>
            <a href="/orders">Orders</a>
            <a href="/myPayments">My Payments</a>
            <a href="/about">About Us</a>
        </nav>
    </header>

    <section class="orders-section">
        <h2>Orders for Table <%= tableNumber %>
        </h2>

        <% if (orders.length===0) { %>
            <p>No orders placed yet.</p>
            <% } else { %>
                <% orders.forEach(order=> { %>
                    <div class="order-card glass">

                        <p><strong>Order Time:</strong>
                            <%= new Date(order.orderedAt).toLocaleString() %>
                        </p>

                        <ul>
                            <% order.items.forEach(item=> { %>
                                <li>
                                    <%= item.item %> × <%= item.quantity %>
                                            — ₹ <%= item.totalPrice %>
                                </li>
                                <% }) %>
                        </ul>

                        <p class="total">
                            Grand Total: ₹ <%= order.grandTotal %>
                        </p>
                        <p class="status <%= order.status.toLowerCase() %>">
                            Status: <strong>
                                <%= order.status %>
                            </strong>
                        </p>

                    </div>
                    <% }) %>
                        <% } %>
    </section>

    <div class="sidebar-overlay"></div>

    <aside class="sidebar">
        <h3>My Restaurant</h3>

        <a href="/">Home</a>
        <a href="/menu">Menu</a>
        <a href="/bookTable">Book a Table</a>
        <a href="/cart">Cart</a>
        <a href="/orders">Orders</a>
        <a href="/myPayments">My Payments</a>
        <a href="/about">About Us</a>
    </aside>

</body>

</html>
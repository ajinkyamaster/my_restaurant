<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Menu</title>
    <link rel="stylesheet" href="/styles/menu.css">
</head>

<body>

    <header class="navbar">
        <h1 class="logo">My Restaurant</h1>
        <nav>
            <a href="/">Home</a>
            <a href="/menu">Menu</a>
            <a href="/bookTable">Book a Table</a>
            <a href="/cart">Cart</a>
            <a href="/orders">Orders</a>
            <a href="/payments">My Payments</a>
            <a href="#">About Us</a>
        </nav>
    </header>

    <section class="menu-section">
        <h2>Our Menu</h2>

        <div class="menu-list">
            <% menuItems.forEach((item, index)=> { %>
                <div class="menu-item">
                    <div class="item-details">
                        <span class="item-name">
                            <%= item.name %>
                        </span>
                        <span class="item-price">₹ <%= item.price %></span>
                    </div>
                    <div class="cart-controls">
                        <button class="btn-decrease" onclick="decreaseCount('<%= index %>')">−</button>
                        <input type="number" id="count-<%= index %>" class="item-count" value="0" min="0" readonly>
                        <button class="btn-increase" onclick="increaseCount('<%= index %>')">+</button>
                        <button class="btn-add-cart"
                            onclick="addToCart(<%= index %>, '<%= item.name %>', <%= item.price %>)">Add to
                            Cart</button>
                    </div>
                </div>
                <% }) %>
        </div>
    </section>


    <script>
        function increaseCount(index) {
            const countInput = document.getElementById('count-' + index);
            countInput.value = parseInt(countInput.value) + 1;
        }

        function decreaseCount(index) {
            const countInput = document.getElementById('count-' + index);
            if (parseInt(countInput.value) > 0) {
                countInput.value = parseInt(countInput.value) - 1;
            }
        }

        async function addToCart(index, itemName, itemPrice) {
            const countInput = document.getElementById('count-' + index);
            const quantity = parseInt(countInput.value);

            if (quantity === 0) {
                alert("Please select a quantity");
                return;
            }

            const response = await fetch("/cart/add", {
                method: "POST",
                headers: {
                    "Content-Type": "application/json"
                },
                body: JSON.stringify({
                    item: itemName,
                    quantity: quantity,
                    price: itemPrice
                })
            });

            const data = await response.json();

            if (response.ok) {
                alert(`${quantity} x ${itemName} added to cart`);
                countInput.value = 0;
            } else {
                alert(data.message || "Failed to add to cart");
            }
        }
    </script>


</body>

</html>
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Menu</title>
    <link
        href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Inter:wght@300;400;500;600&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="/styles/base.css">
    <link rel="stylesheet" href="/styles/layout.css">
    <link rel="stylesheet" href="/styles/components.css">
    <link rel="stylesheet" href="/styles/pages/menu.css">

    <script src="/scripts/menu-cart.js" defer></script>

    <link rel="stylesheet" href="/styles/mobile-nav.css">
    <script src="/scripts/mobile-nav.js" defer></script>
</head>

<body>

    <header class="navbar">
        <h1 class="logo">My Restaurant</h1>

         <div class="hamburger">
            <span></span>
            <span></span>
            <span></span>
        </div>

        <nav>
            <a href="/">Home</a>
            <a href="/menu">Menu</a>
            <a href="/bookTable">Book a Table</a>
            <a href="/cart">Cart</a>
            <a href="/orders">Orders</a>
            <a href="/myPayments">My Payments</a>
            <a href="/about">About Us</a>
        </nav>
    </header>

    <section class="menu-section">
        <h2>Our Menu</h2>

        <% if (message) { %>
            <div class="alert-warning glass">
                <%= message %>
            </div>
            <% } %>


                <div class="menu-list">
                    <% menuItems.forEach((item, index)=> { %>
                        <div class="menu-item">

                            <!-- LEFT: IMAGE -->
                            <div class="menu-item-image">
                                <img src="/images/<%= item.name.toLowerCase().replace(/\s+/g, '-')%>.jpg" alt="<%= item.name %>" onerror="this.src='/images/veg-biryani.jpg'">
                            </div>

                            <!-- CENTER: DETAILS -->
                            <div class="item-details">
                                <span class="item-name">
                                    <%= item.name %>
                                </span>
                                <p class="item-desc">
                                    Chef’s special preparation with premium ingredients.
                                </p>
                                <span class="item-price">₹ <%= item.price %></span>
                            </div>

                            <!-- RIGHT: ACTION -->
                            <div class="cart-controls">
                                <button class="btn-add-cart" onclick="addToCart('<%= item.name %>', <%= item.price %>)">
                                    Add to Cart
                                </button>
                            </div>

                        </div>

                        <% }) %>
                </div>

                <div id="menu-cart-preview" class="menu-cart-preview" style="display: none;">

                    <h4>Your Cart</h4>

                    <ul id="cart-preview-list" class="cart-preview-items">
                        <!-- items will be appended here dynamically -->
                    </ul>

                    <a href="/cart" class="btn-go-cart">
                        Go to Cart
                    </a>
                </div>



    </section>

    <div class="sidebar-overlay"></div>

    <aside class="sidebar">
        <h3>My Restaurant</h3>

        <a href="/">Home</a>
        <a href="/menu">Menu</a>
        <a href="/bookTable">Book a Table</a>
        <a href="/cart">Cart</a>
        <a href="/orders">Orders</a>
        <a href="/myPayments">My Payments</a>
        <a href="/about">About Us</a>
    </aside>

</body>

</html>
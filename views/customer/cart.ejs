<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">    <meta name="viewport" content="width=device-width, initial-scale=1.0">    <title>Your Cart</title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/styles/base.css">
<link rel="stylesheet" href="/styles/layout.css">
<link rel="stylesheet" href="/styles/components.css">
<link rel="stylesheet" href="/styles/pages/cart.css">

    <script src="/scripts/cart-quantity.js" defer></script>

    <link rel="stylesheet" href="/styles/mobile-nav.css">
    <script src="/scripts/mobile-nav.js" defer></script>
</head>

<body>

    <header class="navbar">
        <h1 class="logo">My Restaurant</h1>

         <div class="hamburger">
            <span></span>
            <span></span>
            <span></span>
        </div>

        <nav>
            <a href="/">Home</a>
            <a href="/menu">Menu</a>
            <a href="/bookTable">Book a Table</a>
            <a href="/cart">Cart</a>
            <a href="/orders">Orders</a>
                <a href="/myPayments">My Payments</a>
            <a href="/about">About Us</a>
        </nav>
    </header>

    <section class="cart-section">
    <div class="cart-card glass">
        <h2>Your Cart</h2>

        <% if (cart.length===0) { %>
            <div id="empty-text-container">
                 <p class="empty-text">Your cart is empty.</p>
            <a href="/menu" class="btn btn-outline">Go back to Menu</a>
            </div>
           
        <% } else { %>
                <table class="cart-table">
                    <tr>
                        <th>Item</th>
                        <th>Quantity</th>
                        <th>Total Price</th>
                        <th>Actions</th>
                    </tr>

                    <% cart.forEach((item, index)=> { %>
                        <tr data-item="<%= item.item %>" data-price="<%= item.price %>">
                            <td>
                                <%= item.item %>
                            </td>

                            <td>
                                <div class="quantity-controls">
                                    <button class="btn-decrease" onclick="decreaseCount('<%= item.item %>')">−</button>

                                    <input type="number" id="qty-<%= index %>" class="quantity-value"
                                        value="<%= item.quantity %>" readonly>

                                    <button class="btn-increase" onclick="increaseCount('<%= item.item %>')">+</button>
                                </div>
                            </td>

                            <td>
                                ₹ <span id="item-total-<%= index %>">
                                    <%= item.totalPrice %>
                                </span>
                            </td>

                            <td>
                                <button class="btn-remove" onclick="removeItem('<%= item.item %>')">Remove</button>
                            </td>
                        </tr>
                        <% }) %>
                </table>

                <h3>
                    Grand Total: ₹
                    <span id="grand-total">
                        <%= grandTotal %>
                    </span>
                </h3>


                <form method="POST" action="/checkout">
                    <button type="submit" class="btn-checkout">
                        Place Order
                    </button>
                </form>
       <% } %>
    </div>
</section>

    <div class="sidebar-overlay"></div>

    <aside class="sidebar">
        <h3>My Restaurant</h3>

        <a href="/">Home</a>
        <a href="/menu">Menu</a>
        <a href="/bookTable">Book a Table</a>
        <a href="/cart">Cart</a>
        <a href="/orders">Orders</a>
        <a href="/myPayments">My Payments</a>
        <a href="/about">About Us</a>
    </aside>

</body>

</html>
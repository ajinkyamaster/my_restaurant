<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Your Cart</title>
    <link rel="stylesheet" href="/styles/cart.css">
</head>
<body>

<header class="navbar">
        <h1 class="logo">My Restaurant</h1>
        <nav>
            <a href="/">Home</a>
            <a href="/menu">Menu</a>
            <a href="/bookTable">Book a Table</a>
            <a href="/cart">Cart</a>
            <a href="/orders">Orders</a>
            <a href="/payments">My Payments</a>
            <a href="#">About Us</a>
        </nav>
    </header>

<section class="cart-section">
    <h2>Your Cart</h2>

    <% if (cart.length === 0) { %>
        <p>Your cart is empty.</p>
        <a href="/menu">Go back to Menu</a>
    <% } else { %>
        <table class="cart-table">
            <tr>
                <th>Item</th>
                <th>Quantity</th>
                <th>Total Price</th>
            </tr>

            <% cart.forEach(item => { %>
                <tr>
                    <td><%= item.item %></td>
                    <td><%= item.quantity %></td>
                    <td>₹ <%= item.totalPrice %></td>
                </tr>
            <% }) %>
        </table>

        <h3>Grand Total: ₹ <%= grandTotal %></h3>

        <form method="POST" action="/checkout">
            <button type="submit" class="btn-checkout">
                Place Order
            </button>
        </form>
    <% } %>
</section>

</body>
</html>

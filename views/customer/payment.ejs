<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Payment</title>
    <link rel="stylesheet" href="/styles/payment.css">
</head>

<body>

    <header class="navbar">
        <h1 class="logo">My Restaurant</h1>
        <nav>
            <a href="/">Home</a>
            <a href="/menu">Menu</a>
            <a href="/cart">Cart</a>
            <a href="/payment">My Payments</a>
            <a href="/bookTable">Book a Table</a>
        </nav>
    </header>

    <section class="payment-section">
        <h2>Payment Summary</h2>

        <p class="table-info">
            <strong>Table Number:</strong> <%= tableNumber %>
        </p>

        <% if (cart.length === 0) { %>
            <p>Your cart is empty.</p>
            <a href="/menu">Go back to Menu</a>
        <% } else { %>

            <table class="payment-table">
                <thead>
                    <tr>
                        <th>Item</th>
                        <th>Quantity</th>
                        <th>Total Price</th>
                    </tr>
                </thead>
                <tbody>
                    <% cart.forEach(item => { %>
                        <tr>
                            <td><%= item.item %></td>
                            <td><%= item.quantity %></td>
                            <td>₹ <%= item.totalPrice %></td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>

            <div class="total-section">
                <h3>Grand Total: ₹ <%= grandTotal %></h3>
            </div>

            <form method="POST" action="/makePayment">
                <button type="submit" class="btn-pay">
                    Make Payment
                </button>
            </form>

        <% } %>
    </section>

</body>
</html>

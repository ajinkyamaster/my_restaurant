<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Book a Table</title>
    <link rel="stylesheet" href="/styles/bookTable.css">
</head>

<body>

    <header class="navbar">
        <h1 class="logo">My Restaurant</h1>
        <nav>
            <a href="/">Home</a>
            <a href="/menu">Menu</a>
            <a href="/bookTable">Book a Table</a>
            <a href="/cart">Cart</a>
            <a href="/orders">Orders</a>
            <a href="/payments">My Payments</a>
            <a href="#">About Us</a>
        </nav>
    </header>

    <section class="booking-section">
        <h2>Book a Table</h2>

        <form class="booking-form" method="POST" action="/bookTable">
            <div class="form-group">
                <label for="name">Name:</label>
                <input type="text" id="name" name="name" placeholder="Enter your name" required>
            </div>

            <div class="form-group">
                <label for="capacity">Number of Members:</label>
                <input type="number" id="capacity" name="capacity" min="1" placeholder="Enter number of members"
                    required>
            </div>

            <div class="form-group">
                <label for="time">Time:</label>
                <input type="time" id="time" name="time" required>
            </div>

            <div class="form-group">
                <label for="phone">Phone Number:</label>
                <input type="tel" id="phone" name="phone" placeholder="Enter your phone number" required>
            </div>

            <button type="submit" class="btn-submit">Book Table</button>
        </form>

    </section>

</body>

</html>
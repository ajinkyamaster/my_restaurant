<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Book a Table</title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
   <link rel="stylesheet" href="/styles/base.css">
<link rel="stylesheet" href="/styles/layout.css">
<link rel="stylesheet" href="/styles/components.css">
<link rel="stylesheet" href="/styles/pages/bookTable.css">

    <link rel="stylesheet" href="/styles/mobile-nav.css">
    <script src="/scripts/mobile-nav.js" defer></script>
</head>

<body>

    <header class="navbar">
        <h1 class="logo">My Restaurant</h1>

         <div class="hamburger">
            <span></span>
            <span></span>
            <span></span>
        </div>

        <nav>
            <a href="/">Home</a>
            <a href="/menu">Menu</a>
            <a href="/bookTable">Book a Table</a>
            <a href="/cart">Cart</a>
            <a href="/orders">Orders</a>
            <a href="/myPayments">My Payments</a>
            <a href="/about">About Us</a>
        </nav>
    </header>

  <section class="booking-section">
    <div class="booking-card">
        <h2>Book a Table</h2>

        <% if (errorMessage) { %>
            <p class="error-message"><%= errorMessage %></p>
        <% } %>

        <form class="booking-form" method="POST" action="/bookTable">

            <div class="form-group">
                <label for="name">Name:</label>
                <input
                    type="text"
                    id="name"
                    name="name"
                    placeholder="Enter your name"
                    required>
            </div>

            <div class="form-group">
                <label for="tableNumber">Table Number:</label>
                <input
                    type="number"
                    id="tableNumber"
                    name="tableNumber"
                    min="1"
                    placeholder="Enter table number"
                    value="<%= typeof tableNumber !== 'undefined' ? tableNumber : '' %>"
                    required>
            </div>

            <button type="submit" class="btn-submit">
                Book Table
            </button>

        </form>
    </div>
</section>

    <div class="sidebar-overlay"></div>

    <aside class="sidebar">
        <h3>My Restaurant</h3>

        <a href="/">Home</a>
        <a href="/menu">Menu</a>
        <a href="/bookTable">Book a Table</a>
        <a href="/cart">Cart</a>
        <a href="/orders">Orders</a>
        <a href="/myPayments">My Payments</a>
        <a href="/about">About Us</a>
    </aside>

</body>

</html>
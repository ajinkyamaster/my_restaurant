<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Restaurant | Home</title>
    <link
        href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Inter:wght@300;400;500;600&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="/styles/common.css">
    <link rel="stylesheet" href="/styles/base.css">
    <link rel="stylesheet" href="/styles/layout.css">
    <link rel="stylesheet" href="/styles/components.css">
    <link rel="stylesheet" href="/styles/pages/home.css">

</head>

<body>

    <header class="navbar">
        <h1 class="logo">My Restaurant</h1>

        <nav>
            <a href="/">Home</a>
            <a href="/menu">Menu</a>
            <a href="/bookTable">Book a Table</a>
            <a href="/cart">Cart</a>
            <a href="/orders">Orders</a>
            <a href="/myPayments">My Payments</a>
            <a href="/about">About Us</a>
        </nav>
    </header>

    <section class="hero">
        <div class="hero-content">
            <h2>Dine Smart. Order Easy.</h2>
            <p>Explore our menu and book your table seamlessly.</p>

            <div class="hero-buttons">
                <a href="/menu">
                    <button class="btn btn-outline">View Menu</button>
                </a>
                <a href="/bookTable">
                    <button class="btn btn-primary">Book a Table</button>
                </a>
            </div>

            <div class="staff-access">
                <a href="/manager/login">Manager Login</a>
                <span>|</span>
                <a href="/admin/login">Admin Login</a>
            </div>



            <div class="end-session-link">
                <a href="/endSession">Finished Dining? End Session</a>
            </div>
        </div>
    </section>


    <section class="info">
        <div class="info-card">
            <h3>Fresh Food</h3>
            <p>Prepared with the best ingredients.</p>
        </div>
        <div class="info-card">
            <h3>Easy Ordering</h3>
            <p>Order directly from your table.</p>
        </div>
        <div class="info-card">
            <h3>Comfort Dining</h3>
            <p>Relax while we serve you.</p>
        </div>
    </section>

    <footer class="footer">
        <p>© 2026 My Restaurant. All rights reserved.</p>
    </footer>

</body>

</html>
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <title>Restaurant | Home</title>
    <link rel="stylesheet" href="/styles/home.css">
</head>

<body>

    <header class="navbar">
        <h1 class="logo">My Restaurant</h1>
        <nav>
            <a href="/">Home</a>
            <a href="/menu">Menu</a>
            <a href="/bookTable">Book a Table</a>
            <a href="/cart">Cart</a>
            <a href="/orders">Orders</a>
            <a href="/payments">My Payments</a>
            <a href="#">About Us</a>
        </nav>
    </header>

    <section class="hero">
        <h2>Dine Smart. Order Easy.</h2>
        <p>Explore our menu and book your table seamlessly.</p>
        <div class="hero-buttons">
            <a href="/menu">
                <button>View Menu</button>
            </a>
            <a href="/bookTable">
                <button>Book a Table</button>
            </a>
        </div>
        <% if (typeof table !== "undefined") { %>
    <div class="end-session-link">
        <a href="/endSession">Finished Dining? End Session</a>
    </div>
<% } %>


    </section>

    <section class="info">
        <div class="info-card">
            <h3>Fresh Food</h3>
            <p>Prepared with the best ingredients.</p>
        </div>
        <div class="info-card">
            <h3>Easy Ordering</h3>
            <p>Order directly from your table.</p>
        </div>
        <div class="info-card">
            <h3>Comfort Dining</h3>
            <p>Relax while we serve you.</p>
        </div>
    </section>

    <footer class="footer">
        <p>© 2026 My Restaurant. All rights reserved.</p>
    </footer>

</body>

</html>
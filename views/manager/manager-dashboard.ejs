<!DOCTYPE html>
<html>
<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manager Dashboard</title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/styles/base.css">
<link rel="stylesheet" href="/styles/layout.css">
<link rel="stylesheet" href="/styles/components.css">
<link rel="stylesheet" href="/styles/manager-side-styles/manager-dashboard.css">

    <script src="/scripts/manager-orders.js"></script>

</head>
<body>

<header class="navbar">
    <h1 class="logo">Manager Dashboard</h1>

    <nav>
        <a href="/manager/dashboard">Dashboard</a>
        <a href="/manager/logout">Logout</a>
    </nav>
</header>

<section class="orders-container">

    <% if (orders.length === 0) { %>
        <div class="no-orders">
            <p>No orders yet!</p>
        </div>
    <% } else { %>
        <% orders.forEach(order => { %>
            <div class="order-card glass">

                <div class="order-left">
                    <h3>Table <%= order.tableNumber %></h3>
                    <p><strong>Customer:</strong> <%= order.customer.name %></p>

                    <ul>
                        <% order.items.forEach(item => { %>
                            <li>
                                <%= item.item %> × <%= item.quantity %>
                                — ₹<%= item.totalPrice %>
                            </li>
                        <% }) %>
                    </ul>

                    <p class="total">Total: ₹<%= order.grandTotal %></p>
                </div>

                <div class="order-right" id="order-<%= order._id %>">
                    <% if (order.status === "PLACED") { %>
                        <button 
                            class="btn-accept"
                            onclick="acceptOrder('<%= order._id %>')">
                            Accept Order
                        </button>
                    <% } else { %>
                        <span class="order-confirmed">✅ Order Confirmed!</span>
                    <% } %>
                </div>
            </div>
        <% }) %>
    <% } %>

</section>

</body>
</html>
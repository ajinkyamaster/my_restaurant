<!DOCTYPE html>
<html>
<head>
    <title>All Bookings</title>
<link rel="stylesheet" href="/styles/admin-side-styles/admin-bookings.css">
</head>
<body>

<header class="admin-navbar">
    <h1>All Bookings</h1>
    <a href="/admin/dashboard">Back to Dashboard</a>
</header>

<section class="content">
    <table>
        <thead>
            <tr>
                <th>Customer Name</th>
                <th>Table Number</th>
                <th>Capacity</th>
                <th>Booking Time</th>
            </tr>
        </thead>
        <tbody>
            <% bookings.forEach(b => { %>
                <tr>
                    <td><%= b.customerName %></td>
                    <td><%= b.tableNumber %></td>
                    <td><%= b.requestedCapacity %></td>
                    <td><%= new Date(b.dateTimeIn).toLocaleString() %></td>
                </tr>
            <% }) %>
        </tbody>
    </table>
</section>

</body>
</html>

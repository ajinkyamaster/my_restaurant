<!DOCTYPE html>
<html>
<head>
    <title>Edit Menu Item</title>
    <link rel="stylesheet" href="/styles/admin-side-styles/admin-menu.css">
</head>
<body>

<header class="admin-navbar">
    <h1>Edit Menu Item</h1>
    <a href="/admin/menu">Back</a>
</header>

<section class="content">
    <form method="POST" action="/admin/editMenuItem">
        <input type="hidden" name="id" value="<%= item._id %>">

        <label>Item Name</label><br>
        <input type="text" name="name" value="<%= item.name %>" required><br><br>

        <label>Price</label><br>
        <input type="number" name="price" value="<%= item.price %>" required><br><br>

        <button class="btn-add">Update Item</button>
    </form>
</section>

</body>
</html>

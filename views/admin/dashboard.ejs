<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard</title>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/styles/base.css">
<link rel="stylesheet" href="/styles/layout.css">
<link rel="stylesheet" href="/styles/components.css">
<link rel="stylesheet" href="/styles/admin-side-styles/admin-common.css"> <!-- NEW -->
<link rel="stylesheet" href="/styles/admin-side-styles/admin-dashboard.css"> <!-- page-specific -->

<link rel="stylesheet" href="/styles/mobile-nav.css">
<script src="/scripts/mobile-nav.js" defer></script>
</head>
<body>

<header class="admin-navbar">
    <h1 class="logo">Admin Panel</h1>

     <div class="hamburger">
        <span></span>
        <span></span>
        <span></span>
    </div>

    <nav class="admin-nav-links">
        <a href="/admin/viewAllBookings">View All Bookings</a>
        <a href="/admin/tables">Manage Tables</a>
        <a href="/admin/menu">Manage Menu</a>
        <a href="/admin/allManagers">View All Managers</a>
        <a href="/admin/create-new-admin">Create New Admin</a>
        <a href="/admin/create-new-manager">Create New Manager</a>
        <a href="/admin/vacate-manager">Vacate Manager</a>
         <a href="/admin/logout">Logout</a>
    </nav>
</header>

<section class="dashboard-container">
    <h2 class="welcome-text">
        Welcome <span><%= admin.username %></span>
    </h2>

    <div class="dashboard-cards glass">

        <div class="dashboard-card">
            <a href="/admin/viewAllBookings">
                <h3>📅 View All Bookings</h3>
                <p>See today’s table bookings</p>
            </a>
        </div>

        <div class="dashboard-card">
            <a href="/admin/tables">
                <h3>🪑 Manage Tables</h3>
                <p>Add, remove and manage tables</p>
            </a>
        </div>

        <div class="dashboard-card">
            <a href="/admin/menu">
                <h3>🍽️ Manage Menu</h3>
                <p>Add or update menu items</p>
            </a>
        </div>

        <div class="dashboard-card">
            <a href="/admin/liveTableStatus">
                <h3>📊 Live Table Status</h3>
                <p>View occupied & vacant tables</p>
            </a>
        </div>

    </div>

    <form method="POST" action="/admin/endOfDayReset" class="reset-form">
        <button class="btn-danger">
            🔁 End of Day Reset
        </button>
    </form>
</section>

    <div class="sidebar-overlay"></div>

    <aside class="sidebar">
        <h3>Admin Panel</h3>
        <a href="/admin/dashboard">Dashboard</a>
        <a href="/admin/viewAllBookings">View All Bookings</a>
        <a href="/admin/tables">Manage Tables</a>
        <a href="/admin/menu">Manage Menu</a>
        <a href="/admin/allManagers">View All Managers</a>
        <a href="/admin/create-new-admin">Create New Admin</a>
        <a href="/admin/create-new-manager">Create New Manager</a>
        <a href="/admin/vacate-manager">Vacate Manager</a>
        <a href="/admin/logout">Logout</a>
    </aside>

</body>
</html>

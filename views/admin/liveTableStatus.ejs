<!DOCTYPE html>
<html>

<head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Live Table Status</title>
    <link
        href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=Inter:wght@300;400;500;600&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="/styles/base.css">
    <link rel="stylesheet" href="/styles/layout.css">
    <link rel="stylesheet" href="/styles/components.css">
    <link rel="stylesheet" href="/styles/admin-side-styles/admin-common.css">
    <link rel="stylesheet" href="/styles/admin-side-styles/admin-tables.css">

    <link rel="stylesheet" href="/styles/mobile-nav.css">
    <script src="/scripts/mobile-nav.js" defer></script>
</head>

<body>

    <header class="admin-navbar">
        <h1>Live Table Status</h1>

            <div class="hamburger">
                <span></span>
                <span></span>
                <span></span>
            </div>

        <nav><a href="/admin/dashboard">Back to Dashboard</a></nav>
    </header>

    <section class="content">
        <div class="table-grid">
            <% tables.forEach(t=> { %>
                <div class="table-card <%= t.isVacant ? 'vacant' : 'occupied' %>">
                    <h3>Table <%= t.tableNumber %>
                    </h3>
                    <p>Capacity: <%= t.capacity %>
                    </p>
                    <p class="table-status">
                        Status: <strong>
                            <%= t.isVacant ? "Vacant" : "Occupied" %>
                        </strong>
                    </p>

                </div>
                <% }) %>
        </div>
    </section>

    <div class="sidebar-overlay"></div>

    <aside class="sidebar">
        <h3>Admin Panel</h3>

        <a href="/admin/dashboard">Dashboard</a>
        <a href="/admin/viewAllBookings">View All Bookings</a>
        <a href="/admin/tables">Manage Tables</a>
        <a href="/admin/menu">Manage Menu</a>
        <a href="/admin/allManagers">View All Managers</a>
        <a href="/admin/create-new-admin">Create New Admin</a>
        <a href="/admin/create-new-manager">Create New Manager</a>
        <a href="/admin/vacate-manager">Vacate Manager</a>
        <a href="/admin/logout">Logout</a>
    </aside>

</body>

</html>
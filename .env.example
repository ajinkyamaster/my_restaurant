# ── Database ─────────────────────────────────────────────
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?retryWrites=true&w=majority
DB_NAME=my_restro

# ── Server ───────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Auth (JWT) ───────────────────────────────────────────
# Access tokens last 15 minutes; refresh tokens 7 days and are stored hashed
# in MongoDB so they can be rotated and revoked.
# Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-at-least-32-random-characters

# ── Frontend origin(s) ───────────────────────────────────
# Used for CORS and the CSRF Origin check. Comma-separate multiple origins.
FRONTEND_URL=http://localhost:3000

# ── AI service (optional) ────────────────────────────────
AI_SERVICE_URL=http://localhost:8000
# Shared secret sent as X-AI-Token. Set the same value on the FastAPI service.
# Leave empty to keep the AI service open on a trusted local network only.
AI_SERVICE_TOKEN=

# ── Analytics ────────────────────────────────────────────
# Per-order costs are not stored, so weekly expenses are estimated at this
# fraction of revenue (0.65 = 65% cost, 35% margin).
RESTAURANT_COST_RATIO=0.65
